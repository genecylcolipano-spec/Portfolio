# ---------------------------------------------------------------------------
# Environment variables
#
# Vite loads env files by mode, highest priority first:
#   .env.[mode].local   -> that mode only
#   .env.[mode]         -> that mode only
#   .env.local          -> all modes
#   .env                -> all modes
#
#   `npm run dev`   runs in mode "development"
#   `npm run build` runs in mode "production"
#
# Recommended setup, which keeps the two environments isolated:
#   Local dev   -> copy this file to `.env.development.local` and point it at
#                  a SEPARATE Supabase project from your live one.
#   Production  -> set these as environment variables in your host (Vercel,
#                  Netlify, etc). Keep them out of files on disk entirely.
#
# Never point local development at your live project: the admin dashboard
# deletes rows immediately, with no undo and no soft-delete.
#
# Every .env* file except this one is gitignored. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project URL and anon/publishable key.
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Address the contact form relays to via FormSubmit.
# You must confirm this address once, on the first submission.
VITE_CONTACT_EMAIL=you@example.com

# Optional. Live presence feed for the PresenceWidget component.
# Leave unset and the widget stays hidden.
# VITE_PRESENCE_API=https://your-presence-endpoint/api/presence
